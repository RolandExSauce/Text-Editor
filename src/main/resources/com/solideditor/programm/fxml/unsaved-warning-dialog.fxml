<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- ****************************************************************************************************************-->

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.solideditor.programm.Frontend.Controllers.DialogController">
    <VBox alignment="CENTER"/>
    <Label id="dialog-title" layoutX="218.0" layoutY="174.0" text="You have unsaved changes!"/>
    <HBox layoutX="212.0" layoutY="210.0" spacing="10">
        <Button onAction="#onSave" text="Save"/>
        <Button onAction="#onDiscard" prefHeight="27.0" prefWidth="64.0" text="Discard"/>
        <Button onAction="#onCancelDialog" text="Cancel"/>
    </HBox>
</AnchorPane>
