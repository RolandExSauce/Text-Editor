<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<!-- ****************************************************************************************************************-->
<HBox alignment="CENTER_LEFT" nodeOrientation="LEFT_TO_RIGHT" prefHeight="28.0" prefWidth="600.0"
      fx:controller="com.solideditor.programm.Frontend.controllers.TitleBarController"
      xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      stylesheets="@/com/solideditor/programm/static/css/titlebar.css"
      styleClass="title-bar">

    <!-- Left Side: Tabs -->
    <AnchorPane>
        <TabPane fx:id="tabPane" accessibleRole="BUTTON" nodeOrientation="LEFT_TO_RIGHT"
                 prefHeight="28.0"
                 styleClass="tab-pane">
            <Tab fx:id="defaultTab" styleClass="tab" text="Untitled Tab 1">
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0"/>
            </Tab>
        </TabPane>
    </AnchorPane>

    <!-- Right Side: Buttons -->
    <HBox alignment="TOP_RIGHT" prefHeight="28.0" spacing="5"
    >
        <Button onAction="#minimizeWindow" text="—" styleClass="title-bar-button"/>
        <Button onAction="#maximizeWindow" text="🗖" styleClass="title-bar-button"/>
        <Button onAction="#closeWindow" text="✖" styleClass="title-bar-button-close"/>
    </HBox>
</HBox>
