<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<!-- ****************************************************************************************************************-->

<HBox alignment="CENTER_LEFT" nodeOrientation="LEFT_TO_RIGHT" prefHeight="28.0" prefWidth="600.0" styleClass="title-bar" stylesheets="@/com/solideditor/programm/static/css/titlebar.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.solideditor.programm.Frontend.controllers.TitleBarController">
    <HBox alignment="BOTTOM_LEFT" minWidth="-Infinity" prefHeight="100.0" prefWidth="113.0">
        <ImageView fitHeight="26.0" fitWidth="110.0">
            <Image url="@../static/icons/SolidEdit.png"/>
        </ImageView>
    </HBox>

    <!-- Left Side: Tabs -->
    <AnchorPane>
        <TabPane fx:id="tabPane" accessibleRole="BUTTON" nodeOrientation="LEFT_TO_RIGHT" prefHeight="28.0" styleClass="tab-pane">
            <Tab fx:id="defaultTab" styleClass="tab" text="Untitled Tab 1">
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0" />
            </Tab>
        </TabPane>
    </AnchorPane>

    <!-- Right Side: Buttons -->
    <HBox alignment="TOP_RIGHT" prefHeight="28.0" prefWidth="2000.0" spacing="5">
        <Button onAction="#minimizeWindow" styleClass="title-bar-button" text="—" />
        <Button fx:id="btnMaximize" onAction="#onMaximizeClicked" styleClass="title-bar-button" text="🗖" />
        <Button onAction="#closeWindow" styleClass="title-bar-button-close" text="✖" />
      <HBox.margin>
         <Insets right="10.0" />
      </HBox.margin>
    </HBox>
</HBox>
