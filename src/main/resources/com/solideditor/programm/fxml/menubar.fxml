<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<!-- ****************************************************************************************************************-->
<HBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" prefHeight="50.0"
      prefWidth="800.0" spacing="20.0"
      fx:controller="com.solideditor.programm.Frontend.controllers.MenuBarController"
      style="-fx-background-color: #F2F2EE; -fx-background-radius: 10 10 0 0;" xmlns:fx="http://javafx.com/fxml/1"
      stylesheets="@/com/solideditor/programm/static/css/menubar.css"
>

    <!--MENU BUTTON SECTIONS ****************************************************************************************-->
    <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" prefHeight="100.0" spacing="15.0">
        <Button fx:id="btnOpenFile" alignment="CENTER" contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false"
                style="-fx-background-color: transparent;"
                onAction="#onOpenFileClicked"
        >
            <graphic>
                <ImageView fitHeight="24.0" fitWidth="24.0">
                    <Image url="@../static/icons/openFile.png"/>
                </ImageView>
            </graphic>
        </Button>
        <Button fx:id="btnNewFile" contentDisplay="CENTER" mnemonicParsing="false"
                style="-fx-background-color: transparent;"
                onAction="#onCreateFileClicked"
        >
            <graphic>
                <ImageView fitHeight="24.0" fitWidth="24.0">
                    <Image url="@../static/icons/newFile.png"/>
                </ImageView>
            </graphic>
        </Button>
        <Button fx:id="btnSave" alignment="CENTER" mnemonicParsing="false"
                style="-fx-background-color: transparent;"
                onAction="#onSaveFileClicked"
        >
            <graphic>
                <ImageView fitHeight="24.0" fitWidth="24.0">
                    <Image url="@../static/icons/saveFile.png"/>
                </ImageView>
            </graphic>
        </Button>
        <Button fx:id="btnPrint" alignment="CENTER" mnemonicParsing="false" style="-fx-background-color: transparent;">
            <graphic>
                <ImageView fitHeight="24.0" fitWidth="24.0">
                    <Image url="@../static/icons/printFile.png"/>
                </ImageView>
            </graphic>
        </Button>
        <ComboBox fx:id="fontsComboBox" style="-fx-background-radius: 10; -fx-background-color: #ffffff;">
            <HBox.margin>
                <Insets left="6.0"/>
            </HBox.margin>
        </ComboBox>
        <Button fx:id="btnBold" mnemonicParsing="false" style="-fx-background-color: transparent;" text="B">
            <font>
                <Font name="System Bold" size="14.0"/>
            </font>
        </Button>
        <Button fx:id="btnItalian" mnemonicParsing="false" style="-fx-background-color: transparent;" text="I">
            <font>
                <Font name="Serif Bold Italic" size="14.0"/>
            </font>
        </Button>
        <Button fx:id="btnUnderline" mnemonicParsing="false" style="-fx-background-color: transparent;" text="U"
                underline="true" wrapText="true">
            <font>
                <Font name="Serif Bold" size="14.0"/>
            </font>
        </Button>
    </HBox>
    <!-- *********************************************************************************************************** -->
    <!-- SEARCH TEXT SECTION  -->
    <HBox alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308" prefHeight="35.0" prefWidth="2000.0" spacing="10.0">
        <HBox alignment="CENTER" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="24.0" prefWidth="200.0"
              style="-fx-background-color: #ffffff; -fx-background-radius: 10;">
            <Button mnemonicParsing="false" style="-fx-background-color: transparent;" onAction="#onSearchTxtInFileClicked">
                <graphic>
                    <ImageView disable="true" fitHeight="24.0" fitWidth="24.0">
                        <Image url="@../static/icons/searchTxtInFile.png"/>
                    </ImageView>
                </graphic>
            </Button>
            <TextField fx:id="searchTxtField" prefHeight="26.0" promptText="|"
                       style="-fx-background-color: transparent;"/>
        </HBox>
    </HBox>
</HBox>
