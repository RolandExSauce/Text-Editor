<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<!-- ****************************************************************************************************************-->
<HBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="Infinity" prefHeight="50.0" prefWidth="1000.0"
      style="-fx-background-color: Transparent;" styleClass="menu-bar"
      stylesheets="@/com/solideditor/programm/static/css/menubar.css" xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.solideditor.programm.Frontend.Controllers.MenuBarController">
    <HBox maxWidth="1.7976931348623157E308" prefHeight="100.0" prefWidth="8000.0"
          style="-fx-background-color: #F2F2EE; -fx-background-radius: 5;">
        <HBox.margin>
            <Insets left="5.0" right="5.0"/>
        </HBox.margin>
        <padding>
            <Insets left="10.0" right="10.0"/>
        </padding>

        <!--MENU BUTTON SECTIONS ************************************************************************************-->
        <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" prefHeight="100.0" spacing="15.0">
            <Button fx:id="btnOpenFile" alignment="CENTER" contentDisplay="GRAPHIC_ONLY" mnemonicParsing="false"
                    onAction="#onOpenFileClicked" style="-fx-background-color: transparent;">
                <tooltip>
                    <Tooltip text="Open File"/>
                </tooltip>
                <graphic>
                    <ImageView fitHeight="24.0" fitWidth="24.0">
                        <Image url="@../static/icons/openFile.png"/>
                    </ImageView>
                </graphic>
            </Button>
            <Button fx:id="btnNewFile" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onCreateFileClicked"
                    style="-fx-background-color: transparent;">
                <tooltip>
                    <Tooltip text="New File"/>
                </tooltip>
                <graphic>
                    <ImageView fitHeight="24.0" fitWidth="24.0">
                        <Image url="@../static/icons/newFile.png"/>
                    </ImageView>
                </graphic>
            </Button>
            <Button fx:id="btnSave" alignment="CENTER" mnemonicParsing="false" onAction="#onSaveFileClicked"
                    style="-fx-background-color: transparent;">
                <tooltip>
                    <Tooltip text="Save File"/>
                </tooltip>
                <graphic>
                    <ImageView fitHeight="24.0" fitWidth="24.0">
                        <Image url="@../static/icons/saveFile.png"/>
                    </ImageView>
                </graphic>
            </Button>
            <Button fx:id="btnPrint" alignment="CENTER" mnemonicParsing="false"
                    style="-fx-background-color: transparent;">
                <tooltip>
                    <Tooltip text="Print File"/>
                </tooltip>
                <graphic>
                    <ImageView fitHeight="24.0" fitWidth="24.0">
                        <Image url="@../static/icons/printFile.png"/>
                    </ImageView>
                </graphic>
            </Button>
            <ComboBox fx:id="fontsComboBox" editable="true" maxWidth="-Infinity" minWidth="145.0" prefWidth="145.0"
                      style="-fx-background-radius: 10; -fx-background-color: #ffffff;">
                <HBox.margin>
                    <Insets left="6.0"/>
                </HBox.margin>
            </ComboBox>
        </HBox>
        <!-- ******************************************************************************************************* -->
        <!-- SEARCH TEXT SECTION  -->
        <HBox alignment="CENTER_RIGHT" maxWidth="1.7976931348623157E308" prefHeight="50.0" prefWidth="2000.0"
              spacing="10.0">
            <HBox alignment="CENTER" maxHeight="-Infinity" minHeight="-Infinity" prefHeight="24.0" prefWidth="200.0"
                  style="-fx-background-color: #ffffff; -fx-background-radius: 10;">
                <Button mnemonicParsing="false" style="-fx-background-color: transparent;">
                    <graphic>
                        <ImageView disable="true" fitHeight="24.0" fitWidth="24.0">
                            <Image url="@../static/icons/searchTxtInFile.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                <TextField fx:id="searchTxtField" prefHeight="26.0" promptText="Search in File"
                           style="-fx-background-color: transparent;"/>
            </HBox>
            <Label fx:id="lableFoundAt" prefWidth="70.0" text="Found at:"/>
            <padding>
                <Insets right="100.0"/>
            </padding>
        </HBox>
    </HBox>
</HBox>
