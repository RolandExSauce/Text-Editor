<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<!-- ****************************************************************************************************************-->
<HBox alignment="CENTER_LEFT" nodeOrientation="LEFT_TO_RIGHT" prefHeight="28.0" prefWidth="600.0"
      style="-fx-background-color: #1D2128;"
      fx:controller="com.solideditor.programm.Frontend.controllers.TitleBarController"
      xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      stylesheets="@/com/solideditor/programm/css/titlebar.css"
>
    <HBox prefHeight="0.0" prefWidth="362.0" style="-fx-background-color: #1D2128;">
        <TabPane fx:id="tabPane" accessibleRole="BUTTON" cache="true" nodeOrientation="LEFT_TO_RIGHT" prefHeight="28.0"
                 prefWidth="361.0"
                 style="-fx-background-color: transparent;">
            <cursor>
                <Cursor fx:constant="DEFAULT"/>
            </cursor>
            <Tab fx:id="defaultTab" style="-fx-background-radius: 5 5 0 0;" text="Untitled Tab 1">
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0"/>
            </Tab>
        </TabPane>
    </HBox>
    <HBox alignment="TOP_RIGHT" prefHeight="28.0" prefWidth="607.0" spacing="5" style="-fx-background-color: #1D2128;">
        <Button onAction="#minimizeWindow" style="-fx-background-color: transparent; -fx-text-fill: white;" text="—"/>
        <Button onAction="#maximizeWindow" style="-fx-background-color: transparent; -fx-text-fill: white;" text="🗖"/>
        <Button onAction="#closeWindow" style="-fx-background-color: transparent; -fx-text-fill: red;" text="✖"/>
    </HBox>
</HBox>
